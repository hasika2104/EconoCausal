# EconoCausal Environment Configuration Example
# Copy to .env for local development

# FastAPI Backend Settings
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production

# Optional: Google Gemini API Key for conversational AI pricing analyst
# If omitted, EconoCausal uses its built-in empirical analytical reasoning engine
GEMINI_API_KEY=

# Frontend Production API URL (Optional, defaults to relative /api when proxied or deployed together)
VITE_API_URL=http://127.0.0.1:8000/api
